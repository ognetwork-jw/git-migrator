{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalEnv": ["GM_INSTALL_ORIGIN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "dev": {
      "persistent": true,
      "cache": false,
      "env": ["HOST", "PORT"],
      "passThroughEnv": [
        "POSTGRES_PASSWORD",
        "BETTER_AUTH_SECRET",
        "ENTRA_CLIENT_ID",
        "ENTRA_CLIENT_SECRET",
        "BITBUCKET_CREDENTIALS",
        "GITHUB_APP_PRIVATE_KEY",
        "ATLASSIAN_ADMIN_API_KEY",
        "GM_TEST_USER_PASSWORD"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
