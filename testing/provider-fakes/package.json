{
  "name": "@git-migrator/provider-fakes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Stateful HTTP fakes of the provider APIs plus a git http-backend server.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "test": "vitest run --root ../.. --project unit testing/provider-fakes",
    "start": "node src/main.ts",
    "start:git": "node src/git/main.ts",
    "start:github": "node src/github/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "graphql": "16.9.0",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "openapi-response-validator": "12.1.3"
  }
}
