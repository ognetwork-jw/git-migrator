{
  "name": "@git-migrator/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Process entrypoints: worker roles, scheduler, migrate.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
