{
  "name": "@git-migrator/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js app: UI and Hono API.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b && next build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "test": "vitest run --root ../.. --project unit apps/web",
    "dev": "next dev -H ${HOST:-127.0.0.1}",
    "start": "node scripts/start-standalone.mjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "@git-migrator/api": "workspace:*",
    "@git-migrator/auth": "workspace:*",
    "@git-migrator/canonical": "workspace:*",
    "@git-migrator/config": "workspace:*",
    "@git-migrator/core": "workspace:*",
    "@git-migrator/db": "workspace:*",
    "@git-migrator/facets": "workspace:*",
    "@git-migrator/jobs": "workspace:*",
    "@git-migrator/observability": "workspace:*",
    "@git-migrator/quota": "workspace:*",
    "@git-migrator/registry": "workspace:*",
    "@hono/node-server": "2.1.4",
    "@tanstack/react-query": "5.90.5",
    "antd": "6.6.5",
    "hono": "4.13.13",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "27.0.1",
    "oxc-parser": "0.153.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3"
  }
}
