{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "lib": ["ES2024", "DOM"],
    "jsx": "react-jsx",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node"]
  },
  "include": ["next-env.d.ts", "src", "app", "i18n", "messages/*.json", "next.config.ts"],
  "exclude": ["src/**/*.test.*", "src/**/*.spec.*", "app/**/*.test.*", "src/test-render.tsx"],
  "references": [
    {
      "path": "../../packages/api"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/auth"
    },
    {
      "path": "../../packages/config"
    },
    {
      "path": "../../packages/observability"
    },
    {
      "path": "../../packages/db"
    }
  ]
}
