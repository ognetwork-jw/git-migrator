// git-migrator domain model (docs/spec/03-domain-model.md, DOM-001 ... DOM-014).
//
// Conventions (DOM-003):
//  - IDs are UUIDv7 (`@default(uuid(7))`), generated by the ZenStack ORM.
//  - Tables are snake_case through @@map, columns through @map. Every model lives in schema `app`.
//  - Every model has createdAt/updatedAt, except the append-only QuotaEvent, RunLog and AuditEvent.
//  - Better Auth tables live in schema `auth` and are NOT modeled here (ADR-0008).
//  - Relations (FKs) are declared with @relation. Deletion is restricted by default; the only
//    cascades are Run -> RunStep/RunLog and Analysis -> PlanItem (DOM-004).
//
// Access policies (DOM-005, API-012, AUTH-020, AUTH-021): every model is default-deny for writes
// through the policy-enforcing client. Only the RPC writes allow-listed in API-012 are permitted.
// Everything else is written by server code through the privileged client.
//
// Raw-SQL indexes that ZModel cannot express (DATA-011) live in migrations/*_raw_indexes.
// Edit this file, then run `pnpm generate` and `pnpm --filter @git-migrator/db migrate:dev`.

datasource db {
    provider      = 'postgresql'
    url           = env('DATABASE_URL')
    schemas       = ['app']
    defaultSchema = 'app'
}

// Imports in src/generated carry the .ts extension so plain `node` can run them (the migrate entrypoint).
plugin typescript {
    provider = '@core/typescript'
    importWithFileExtension = '.ts'
}

plugin policy {
    provider = '@zenstackhq/plugin-policy'
}

enum ActorKind {
    human
    service

    @@map("actor_kind")
    @@schema('app')
}

enum Role {
    viewer
    operator
    admin

    @@map("role")
    @@schema('app')
}

model Actor {
    id                        String               @id @default(uuid(7))
    kind                      ActorKind
    displayName               String               @map("display_name")
    email                     String?
    role                      Role
    disabled                  Boolean              @default(false)
    authUserId                String?              @unique @map("auth_user_id") // auth.user.id for human actors; no cross-schema FK (DATA-002)
    lastSeenAt                DateTime?            @map("last_seen_at") @db.Timestamptz(3)
    createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt                 DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

    apiKeys                   ApiKey[]
    triggeredRuns             Run[]                @relation('RunTriggeredBy')
    completedTasks            ManualTask[]         @relation('TaskCompletedBy')
    createdExpectedDiffs      ExpectedDifference[] @relation('ExpectedDifferenceCreatedBy')
    decidedIdentityMappings   IdentityMapping[]    @relation('IdentityMappingDecidedBy')
    createdInvitationBatches  InvitationBatch[]    @relation('InvitationBatchCreatedBy')
    approvedInvitationBatches InvitationBatch[]    @relation('InvitationBatchApprovedBy')
    auditEvents               AuditEvent[]

    @@auth
    @@map("actor")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

// Service actors only (AUTH-040).
model ApiKey {
    id         String    @id @default(uuid(7))
    actorId    String    @map("actor_id")
    name       String
    prefix     String    @unique // first 8 chars after "gm_", shown in UI
    hash       String    @deny('read', true) // sha256(full key), hex; never readable through RPC (API-012)
    expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
    lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
    revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
    createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

    actor      Actor     @relation(fields: [actorId], references: [id], onDelete: Restrict)

    @@map("api_key")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

enum EndpointStatus {
    active
    retired

    @@map("endpoint_status")
    @@schema('app')
}

// Upserted from config at startup (ARC-030, DATA-030 step 5).
model Endpoint {
    id           String          @id // config slug, e.g. "source-main"
    providerType String          @map("provider_type") // adapter type, as named in config
    displayName  String          @map("display_name")
    baseUrl      String          @map("base_url")
    status       EndpointStatus
    configHash   String          @map("config_hash")
    createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

    sourceRoutes Route[]         @relation('RouteSource')
    targetRoutes Route[]         @relation('RouteTarget')
    namespaces   Namespace[]
    repositories Repository[]
    snapshots    FacetSnapshot[]
    rawResponses RawResponse[]
    identities   Identity[]
    invitations  Invitation[]
    groups       Group[]

    @@map("endpoint")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

// Upserted from config at startup.
model Route {
    id                  String                  @id // config slug
    sourceEndpointId    String                  @map("source_endpoint_id")
    targetEndpointId    String                  @map("target_endpoint_id")
    targetNamespaceId   String?                 @map("target_namespace_id") // resolved after first target inventory
    targetNamespacePath String                  @map("target_namespace_path") // from config, e.g. "acme-org"
    policies            Json // RoutePolicies type (LIF-011)
    defaults            Json // route defaults (DEP-040)
    configHash          String                  @map("config_hash") // change marks analyses stale (LIF-021)
    sourcePostAction    String                  @map("source_post_action") // "read-only" | "none" (LIF-070)
    retiredAt           DateTime?               @map("retired_at") @db.Timestamptz(3) // set when config sync no longer sees the Route (ADR-0121)
    avgCallsPerAnalysis Float                   @default(30) @map("avg_calls_per_analysis") // rolling mean of provider calls per Analysis (JOB-020, ADR-0310)
    createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

    sourceEndpoint      Endpoint                @relation('RouteSource', fields: [sourceEndpointId], references: [id], onDelete: Restrict)
    targetEndpoint      Endpoint                @relation('RouteTarget', fields: [targetEndpointId], references: [id], onDelete: Restrict)
    targetNamespace     Namespace?              @relation('RouteTargetNamespace', fields: [targetNamespaceId], references: [id], onDelete: Restrict)

    migrations          Migration[]
    expectedDifferences ExpectedDifference[]
    identityMappings    IdentityMapping[]
    groupMappings       GroupMapping[]
    invitationBatches   InvitationBatch[]
    invitations         Invitation[]
    namingRules         NamingRule[]
    webhookAllowlist    WebhookAllowlistEntry[]
    overlays            Overlay[]

    @@map("route")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

model Namespace {
    id             String       @id @default(uuid(7))
    endpointId     String       @map("endpoint_id")
    providerId     String       @map("provider_id") // provider-stable id
    parentId       String?      @map("parent_id")
    kind           String // adapter-defined label, display only
    slug           String
    key            String? // adapter-defined short key of the namespace, if it has one
    name           String
    createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

    endpoint       Endpoint     @relation(fields: [endpointId], references: [id], onDelete: Restrict)
    parent         Namespace?   @relation('NamespaceTree', fields: [parentId], references: [id], onDelete: Restrict)

    children       Namespace[]  @relation('NamespaceTree')
    repositories   Repository[]
    targetOfRoutes Route[]      @relation('RouteTargetNamespace')

    @@unique([endpointId, providerId])
    @@map("namespace")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

enum SourcePresence {
    present
    missing

    @@map("source_presence")
    @@schema('app')
}

enum SizeClass {
    standard
    large

    @@map("size_class")
    @@schema('app')
}

model Repository {
    id                String          @id @default(uuid(7))
    endpointId        String          @map("endpoint_id")
    namespaceId       String          @map("namespace_id")
    providerId        String          @map("provider_id") // adapter-defined stable id
    slug              String
    name              String
    fullPath          String          @map("full_path") // display path, e.g. "ws/PROJ/repo"
    isPrivate         Boolean         @map("is_private")
    sizeBytes         BigInt?         @map("size_bytes")
    sizeClass         SizeClass       @default(standard) @map("size_class")
    presence          SourcePresence  @default(present)
    defaultBranch     String?         @map("default_branch")
    lfsBytes          BigInt?         @map("lfs_bytes") // last known, from runs
    providerUpdatedAt DateTime?       @map("provider_updated_at") @db.Timestamptz(3) // provider's last-updated timestamp
    lastInventoriedAt DateTime        @map("last_inventoried_at") @db.Timestamptz(3)
    createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

    endpoint          Endpoint        @relation(fields: [endpointId], references: [id], onDelete: Restrict)
    namespace         Namespace       @relation(fields: [namespaceId], references: [id], onDelete: Restrict)

    sourceMigrations  Migration[]     @relation('MigrationSourceRepository')
    targetMigrations  Migration[]     @relation('MigrationTargetRepository')
    snapshots         FacetSnapshot[]

    @@unique([endpointId, providerId])
    @@index([endpointId, namespaceId])
    @@index([fullPath(ops: raw("gin_trgm_ops"))], type: Gin, map: "repository_full_path_trgm_idx")
    @@map("repository")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

enum MigrationScope {
    repository
    endpoint

    @@map("migration_scope")
    @@schema('app')
}

enum MigrationStatus {
    discovered
    analyzed
    running
    migrated
    failed
    partial
    verified
    manually_completed
    drifted
    rolled_back
    source_missing

    @@map("migration_status")
    @@schema('app')
}

enum Readiness {
    ready
    needs_attention
    blocked

    @@map("readiness")
    @@schema('app')
}

// Only `waveId` (and the `wave` relation) may be updated through RPC (API-012). Every other
// field (createdAt and updatedAt included; a database trigger sets updated_at, not the ORM), in particular readiness, status, blockerCodes, readinessCounts and the lifecycle
// timestamps, is written only by the privileged client (DOM-011), so each carries
// @deny('update', true). A new field MUST get the same treatment (policy test: DOM-011).
model Migration {
    id                       String               @id @default(uuid(7)) @deny('update', true)
    scope                    MigrationScope       @deny('update', true)
    routeId                  String               @deny('update', true) @map("route_id")
    sourceRepositoryId       String?              @map("source_repository_id") @deny('update', true) // null for endpoint scope
    targetRepositoryId       String?              @map("target_repository_id") @deny('update', true) // set once target exists / adopted
    plannedTargetName        String?              @map("planned_target_name") @deny('update', true)
    status                   MigrationStatus      @default(discovered) @deny('update', true)
    statusBeforeRun          MigrationStatus?     @map("status_before_run") @deny('update', true) // LIF-002 saved statuses
    statusBeforeDrift        MigrationStatus?     @map("status_before_drift") @deny('update', true)
    statusBeforeManual       MigrationStatus?     @map("status_before_manual") @deny('update', true)
    statusBeforeMissing      MigrationStatus?     @map("status_before_missing") @deny('update', true)
    runBlockers              Json                 @default("[]") @map("run_blockers") @deny('update', true) // LIF-049: [{code, params, at}]
    readiness                Readiness?           @deny('update', true)
    readinessCounts          Json?                @map("readiness_counts") @deny('update', true) // {blockers, preTasks, postTasks, warnings}
    blockerCodes             String[]             @map("blocker_codes") @deny('update', true) // promoted for filtering
    latestAnalysisId         String?              @map("latest_analysis_id") @deny('update', true)
    analysisStaleAt          DateTime?            @map("analysis_stale_at") @db.Timestamptz(3) @deny('update', true)
    analysisFailedAt         DateTime?            @map("analysis_failed_at") @db.Timestamptz(3) @deny('update', true) // ADR-0312
    analysisFailureCount     Int                  @default(0) @map("analysis_failure_count") @deny('update', true)
    analysisRetryAt          DateTime?            @map("analysis_retry_at") @db.Timestamptz(3) @deny('update', true) // feeder backoff, database clock (ADR-0312)
    staleGeneration          BigInt               @default(0) @map("stale_generation") @deny('update', true) // bumped by every stale marker (ADR-0310)
    parityGeneration         BigInt               @default(0) @map("parity_generation") @deny('update', true) // bumped by every stored Parity Check (ADR-0396)
    targetCreatedByFramework Boolean              @default(false) @map("target_created_by_framework") @deny('update', true)
    sourceReadOnlyApplied    Boolean              @default(false) @map("source_read_only_applied") @deny('update', true)
    waveId                   String?              @map("wave_id")
    verifiedAt               DateTime?            @map("verified_at") @db.Timestamptz(3) @deny('update', true)
    manualCompletion         Json?                @map("manual_completion") @deny('update', true) // {actorId, reason, at}
    lastParityAt             DateTime?            @map("last_parity_at") @db.Timestamptz(3) @deny('update', true)
    lastDriftCheckAt         DateTime?            @map("last_drift_check_at") @db.Timestamptz(3) @deny('update', true)
    createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(3) @deny('update', true)
    updatedAt                DateTime             @default(now()) @map("updated_at") @db.Timestamptz(3) @deny('update', true)

    route                    Route                @relation(fields: [routeId], references: [id], onDelete: Restrict)
    sourceRepository         Repository?          @relation('MigrationSourceRepository', fields: [sourceRepositoryId], references: [id], onDelete: Restrict)
    targetRepository         Repository?          @relation('MigrationTargetRepository', fields: [targetRepositoryId], references: [id], onDelete: Restrict)
    latestAnalysis           Analysis?            @relation('MigrationLatestAnalysis', fields: [latestAnalysisId], references: [id], onDelete: SetNull)
    wave                     Wave?                @relation(fields: [waveId], references: [id], onDelete: SetNull)

    analyses                 Analysis[]           @relation('AnalysisMigration')
    runs                     Run[]
    mutations                Mutation[]
    manualTasks              ManualTask[]
    expectedDiffs            ExpectedDifference[]
    parityResults            ParityResult[]

    // Also, in the raw-SQL indexes migration (DATA-011): a partial unique index on
    // migration(route_id) WHERE scope = 'endpoint' (one endpoint-scope row per Route, DOM-014).
    @@unique([routeId, sourceRepositoryId])
    @@index([routeId, status, readiness])
    @@index([waveId])
    @@index([blockerCodes], type: Gin)
    @@map("migration")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
    @@allow('update', auth().role in [operator, admin] && auth().disabled == false)
}

model FacetSnapshot {
    id             String      @id @default(uuid(7))
    side           String // "source" | "target" (which endpoint was read)
    endpointId     String      @map("endpoint_id")
    repositoryId   String?     @map("repository_id") // null for endpoint-level facets
    facetKey       String      @map("facet_key")
    schemaVersion  Int         @map("schema_version")
    data           Json // canonical, validated by facet schema
    unreadable     String[] // field paths that could not be read
    hash           String // sha256 of canonical JSON (RFC 8785 JCS)
    fetchedAt      DateTime    @map("fetched_at") @db.Timestamptz(3)
    rawResponseIds String[]    @map("raw_response_ids")
    createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

    endpoint       Endpoint    @relation(fields: [endpointId], references: [id], onDelete: Restrict)
    repository     Repository? @relation(fields: [repositoryId], references: [id], onDelete: Restrict)

    @@index([repositoryId, facetKey, side, fetchedAt(sort: Desc)])
    @@map("facet_snapshot")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

// Pruned after 30 days (DATA-020). Bodies are readable by operator and admin only (AUTH-020).
model RawResponse {
    id         String   @id @default(uuid(7))
    endpointId String   @map("endpoint_id")
    method     String
    url        String // credentials and query secrets stripped
    status     Int
    body       Json?    @deny('read', auth().role == viewer)
    fetchedAt  DateTime @map("fetched_at") @db.Timestamptz(3)
    createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)

    @@map("raw_response")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

model Analysis {
    id                String      @id @default(uuid(7))
    migrationId       String      @map("migration_id")
    sourceSnapshotIds String[]    @map("source_snapshot_ids")
    targetSnapshotIds String[]    @map("target_snapshot_ids")
    readiness         Readiness
    translation       Json // per facet: desired target canonical + field fidelity
    startedAt         DateTime?   @map("started_at") @db.Timestamptz(3) // database clock when the Analysis started (ADR-0310)
    createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

    migration         Migration   @relation('AnalysisMigration', fields: [migrationId], references: [id], onDelete: Restrict)

    items             PlanItem[]
    latestOf          Migration[] @relation('MigrationLatestAnalysis')
    runs              Run[]

    @@map("analysis")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

enum PlanItemKind {
    step
    blocker
    pre_task
    post_task
    warning

    @@map("plan_item_kind")
    @@schema('app')
}

model PlanItem {
    id          String       @id @default(uuid(7))
    analysisId  String       @map("analysis_id")
    facetKey    String       @map("facet_key")
    kind        PlanItemKind
    code        String // e.g. "branch-rules.lossy-merge-check"
    fidelity    String?
    fieldPaths  String[]     @map("field_paths")
    params      Json // rendered into guidance
    order       Int
    createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

    analysis    Analysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)

    manualTasks ManualTask[]

    @@map("plan_item")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

enum RunKind {
    migrate
    run_anyway
    resync
    verify
    rollback
    source_read_only
    undo_source_read_only

    @@map("run_kind")
    @@schema('app')
}

enum RunStatus {
    queued
    running
    succeeded
    partial
    failed
    cancelled

    @@map("run_status")
    @@schema('app')
}

model Run {
    id             String     @id @default(uuid(7))
    migrationId    String     @map("migration_id")
    analysisId     String?    @map("analysis_id")
    kind           RunKind
    status         RunStatus  @default(queued)
    triggeredById  String     @map("triggered_by_id") // Actor
    options        Json // e.g. {adoptNonEmpty, confirmToken}
    startedAt      DateTime?  @map("started_at") @db.Timestamptz(3)
    finishedAt     DateTime?  @map("finished_at") @db.Timestamptz(3)
    leaseOwner     String?    @map("lease_owner") // LIF-046
    leaseExpiresAt DateTime?  @map("lease_expires_at") @db.Timestamptz(3)
    reaperResumes  Int        @default(0) @map("reaper_resumes")
    hasMutations   Boolean    @default(false) @map("has_mutations")
    cancelRequestedAt DateTime? @map("cancel_requested_at") @db.Timestamptz(3) // cooperative cancel (LIF-040, ADR-0340)
    error          Json?
    createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

    migration      Migration  @relation(fields: [migrationId], references: [id], onDelete: Restrict)
    analysis       Analysis?  @relation(fields: [analysisId], references: [id], onDelete: Restrict)
    triggeredBy    Actor      @relation('RunTriggeredBy', fields: [triggeredById], references: [id], onDelete: Restrict)

    steps          RunStep[]
    logs           RunLog[]
    mutations      Mutation[]

    // At most one queued or running Run per Migration (DOM-010): partial unique index
    // run(migration_id) WHERE status IN ('queued','running') in the raw-SQL indexes migration.
    @@map("run")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

enum StepStatus {
    pending
    running
    succeeded
    failed
    skipped

    @@map("step_status")
    @@schema('app')
}

model RunStep {
    id         String     @id @default(uuid(7))
    runId      String     @map("run_id")
    stepKey    String     @map("step_key") // e.g. "git.push-refs", "facet.webhooks.apply"
    facetKey   String?    @map("facet_key")
    order      Int
    status     StepStatus @default(pending)
    attempts   Int        @default(0)
    delays     Int        @default(0) // times the Run was delayed at this step (rate limit, scratch; ADR-0341)
    failures   Int        @default(0) // attempts that ended in a retryable failure or a crash: the retry budget (ADR-0341)
    severity   String? // fatal | independent | advisory, as planned when the row was created (ADR-0341)
    startedAt  DateTime?  @map("started_at") @db.Timestamptz(3)
    finishedAt DateTime?  @map("finished_at") @db.Timestamptz(3)
    error      Json? // AdapterError serialized
    createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

    run        Run        @relation(fields: [runId], references: [id], onDelete: Cascade)

    logs       RunLog[]

    @@unique([runId, order])
    @@map("run_step")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

// Append-only: only its own timestamp.
model RunLog {
    id      String   @id @default(uuid(7))
    runId   String   @map("run_id")
    stepId  String?  @map("step_id")
    ts      DateTime @db.Timestamptz(3)
    level   String
    message String
    data    Json?

    run     Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
    step    RunStep? @relation(fields: [stepId], references: [id], onDelete: NoAction)

    @@map("run_log")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

// Ledger of framework changes (LIF-045).
model Mutation {
    id          String    @id @default(uuid(7))
    migrationId String    @map("migration_id")
    runId       String    @map("run_id")
    side        String // "source" | "target"
    facetKey    String    @map("facet_key")
    resourceRef Json      @map("resource_ref") // adapter-defined pointer, enough to undo
    paths       String[] // canonical field paths touched (LIF-045)
    action      String // create | update | delete
    before      Json?
    after       Json?
    undoneAt    DateTime? @map("undone_at") @db.Timestamptz(3)
    seq         BigInt    @unique @default(autoincrement()) // recording order: undo runs newest first (ADR-0342)
    state       String    @default("recorded") // intended | recorded | not_applied (ADR-0342)
    writtenByStep String? @map("written_by_step") // the Step that wrote it, so a resumed Step finds its open intents
    origin      String    @default("desired") // desired | framework (ADR-0342)
    derivedDifferences Json @default("[]") @map("derived_differences") // [{facetKey, path}] of the Expected Differences this record caused
    createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

    migration   Migration @relation(fields: [migrationId], references: [id], onDelete: Restrict)
    run         Run       @relation(fields: [runId], references: [id], onDelete: Restrict)

    @@map("mutation")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

enum TaskStatus {
    open
    done
    dismissed

    @@map("task_status")
    @@schema('app')
}

// Only `note` may be updated through RPC, by an operator (API-012). Status changes through
// /api/v1 (privileged client), so every other field carries @deny('update', true).
model ManualTask {
    id               String     @id @default(uuid(7)) @deny('update', true)
    migrationId      String     @deny('update', true) @map("migration_id")
    facetKey         String     @deny('update', true) @map("facet_key")
    code             String     @deny('update', true)
    phase            String     @deny('update', true) // "pre" | "post"
    origin           String     @deny('update', true) // "analysis" | "run" (LIF-049)
    params           Json       @deny('update', true)
    verifiable       Boolean    @deny('update', true) // parity can auto-complete it
    status           TaskStatus @default(open) @deny('update', true)
    completedById    String?    @deny('update', true) @map("completed_by_id")
    completedAt      DateTime?  @deny('update', true) @map("completed_at") @db.Timestamptz(3)
    note             String?
    sourcePlanItemId String?    @deny('update', true) @map("source_plan_item_id")
    paramsHash       String     @deny('update', true) @map("params_hash") // sha256(JCS(params))
    createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3) @deny('update', true)
    updatedAt        DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3) @deny('update', true)

    migration        Migration  @relation(fields: [migrationId], references: [id], onDelete: Restrict)
    completedBy      Actor?     @relation('TaskCompletedBy', fields: [completedById], references: [id], onDelete: Restrict)
    sourcePlanItem   PlanItem?  @relation(fields: [sourcePlanItemId], references: [id], onDelete: SetNull)

    @@unique([migrationId, code, facetKey, paramsHash])
    @@map("manual_task")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
    @@allow('update', auth().role in [operator, admin] && auth().disabled == false)
}

enum ExpectedDifferenceReason {
    framework_mutation
    overlay
    lossy_accepted
    identity_excluded
    manual_accepted
    unreadable_defaulted

    @@map("expected_difference_reason")
    @@schema('app')
}

model ExpectedDifference {
    id          String                   @id @default(uuid(7))
    routeId     String                   @map("route_id")
    migrationId String?                  @map("migration_id") // null = applies to every migration on the route
    facetKey    String                   @map("facet_key")
    path        String // field path pattern over desired-vs-target diffs (ADP-020, LIF-063)
    reason      ExpectedDifferenceReason
    note        String?
    createdById String?                  @map("created_by_id") // null when created by the system
    identityMappingId String?            @deny('update', true) @map("identity_mapping_id") // set by an identity_excluded exclusion (AUTH-050); nullable
    invitationId String?                 @deny('update', true) @map("invitation_id") // set when the exclusion is an invitation deselection (AUTH-060 step 3)
    createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
    revokedAt   DateTime?                @map("revoked_at") @db.Timestamptz(3)

    identityMapping IdentityMapping?     @relation(fields: [identityMappingId], references: [id], onDelete: Restrict)
    invitation  Invitation?              @relation(fields: [invitationId], references: [id], onDelete: Restrict)
    route       Route                    @relation(fields: [routeId], references: [id], onDelete: Restrict)
    migration   Migration?               @relation(fields: [migrationId], references: [id], onDelete: Restrict)
    createdBy   Actor?                   @relation('ExpectedDifferenceCreatedBy', fields: [createdById], references: [id], onDelete: Restrict)

    @@index([identityMappingId])
    @@index([invitationId])
    @@map("expected_difference")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

model ParityResult {
    id          String    @id @default(uuid(7))
    migrationId String    @map("migration_id")
    facetKey    String    @map("facet_key")
    status      String // equal | different | unverifiable
    diffs       Json // [{path, source, target}], after exclusions
    excluded    Json // [{path, expectedDifferenceId}]
    checkedAt   DateTime  @map("checked_at") @db.Timestamptz(3)
    createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

    migration   Migration @relation(fields: [migrationId], references: [id], onDelete: Restrict)

    @@map("parity_result")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

model Identity {
    id             String            @id @default(uuid(7))
    endpointId     String            @map("endpoint_id")
    providerId     String            @map("provider_id") // adapter-defined stable id
    login          String? // adapter-defined handle
    displayName    String?           @map("display_name")
    email          String?
    emailSource    String?           @map("email_source") // "atlassian-admin" | "provider-public" | "csv"
    kind           String // user | bot
    isMember       Boolean           @map("is_member") // member of the endpoint's root namespace
    createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

    endpoint       Endpoint          @relation(fields: [endpointId], references: [id], onDelete: Restrict)

    sourceMappings IdentityMapping[] @relation('IdentityMappingSource')
    targetMappings IdentityMapping[] @relation('IdentityMappingTarget')
    invitations    Invitation[]

    @@unique([endpointId, providerId])
    @@map("identity")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

model Group {
    id             String         @id @default(uuid(7))
    endpointId     String         @map("endpoint_id")
    providerId     String         @map("provider_id") // adapter-defined stable id
    slug           String
    name           String
    memberIds      String[]       @map("member_ids") // Identity ids
    createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

    endpoint       Endpoint       @relation(fields: [endpointId], references: [id], onDelete: Restrict)

    sourceMappings GroupMapping[] @relation('GroupMappingSource')
    targetMappings GroupMapping[] @relation('GroupMappingTarget')

    @@unique([endpointId, providerId])
    @@map("group")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

enum MappingStatus {
    suggested
    confirmed
    excluded
    pending_invite
    unmapped

    @@map("mapping_status")
    @@schema('app')
}

model IdentityMapping {
    id               String        @id @default(uuid(7))
    routeId          String        @map("route_id")
    sourceIdentityId String        @map("source_identity_id")
    targetIdentityId String?       @map("target_identity_id")
    status           MappingStatus
    method           String? // email | login | name | csv | manual | invite
    confidence       Float?
    decidedById      String?       @map("decided_by_id")
    decidedAt        DateTime?     @map("decided_at") @db.Timestamptz(3)
    createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

    route            Route         @relation(fields: [routeId], references: [id], onDelete: Restrict)
    sourceIdentity   Identity      @relation('IdentityMappingSource', fields: [sourceIdentityId], references: [id], onDelete: Restrict)
    targetIdentity   Identity?     @relation('IdentityMappingTarget', fields: [targetIdentityId], references: [id], onDelete: Restrict)
    decidedBy        Actor?        @relation('IdentityMappingDecidedBy', fields: [decidedById], references: [id], onDelete: Restrict)
    expectedDifferences ExpectedDifference[]

    @@unique([routeId, sourceIdentityId])
    @@map("identity_mapping")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

model GroupMapping {
    id            String        @id @default(uuid(7))
    routeId       String        @map("route_id")
    sourceGroupId String        @map("source_group_id")
    targetGroupId String?       @map("target_group_id")
    plannedSlug   String        @map("planned_slug")
    status        MappingStatus
    createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

    route         Route         @relation(fields: [routeId], references: [id], onDelete: Restrict)
    sourceGroup   Group         @relation('GroupMappingSource', fields: [sourceGroupId], references: [id], onDelete: Restrict)
    targetGroup   Group?        @relation('GroupMappingTarget', fields: [targetGroupId], references: [id], onDelete: Restrict)

    @@unique([routeId, sourceGroupId])
    @@map("group_mapping")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

enum InvitationBatchStatus {
    draft
    approved
    sending
    sent
    partial

    @@map("invitation_batch_status")
    @@schema('app')
}

enum InvitationStatus {
    selected
    deselected
    sent
    accepted
    failed
    expired
    unknown

    @@map("invitation_status")
    @@schema('app')
}

model InvitationBatch {
    id           String                @id @default(uuid(7))
    routeId      String                @map("route_id")
    status       InvitationBatchStatus @default(draft)
    seatPreview  Json                  @map("seat_preview") // {seatsTotal?, seatsFilled?, toInvite}
    createdById  String                @map("created_by_id")
    approvedById String?               @map("approved_by_id")
    approvedAt   DateTime?             @map("approved_at") @db.Timestamptz(3)
    /// Earliest time the send job may try again after the provider's invitation cap or rate limit (AUTH-060 step 4).
    nextAttemptAt DateTime?            @map("next_attempt_at") @db.Timestamptz(3)
    createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

    route        Route                 @relation(fields: [routeId], references: [id], onDelete: Restrict)
    createdBy    Actor                 @relation('InvitationBatchCreatedBy', fields: [createdById], references: [id], onDelete: Restrict)
    approvedBy   Actor?                @relation('InvitationBatchApprovedBy', fields: [approvedById], references: [id], onDelete: Restrict)

    items        Invitation[]

    @@map("invitation_batch")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

model Invitation {
    id                   String           @id @default(uuid(7))
    batchId              String           @map("batch_id")
    sourceIdentityId     String           @map("source_identity_id")
    email                String
    teamSlugs            String[]         @map("team_slugs")
    status               InvitationStatus @default(selected)
    providerInvitationId String?          @map("provider_invitation_id")
    error                String?
    /// Why the operator deselected the item (AUTH-060 step 3).
    deselectReason       String?          @map("deselect_reason")
    /// Set before the provider call; a retry that finds it set first looks for the invitation (AUTH-061).
    sendStartedAt        DateTime?        @map("send_started_at") @db.Timestamptz(3)
    sentAt               DateTime?        @map("sent_at") @db.Timestamptz(3)
    /// The invitee's login while GitHub reports it on the pending invitation (AUTH-060 step 5.1).
    inviteeLogin         String?          @map("invitee_login")
    /// Set by the guard trigger from the batch (AUTH-061: one outstanding invitation per person and address).
    routeId              String           @default("") @map("route_id")
    /// The target organization, set by the guard trigger from the Route when the item is created and frozen (AUTH-061 is per target).
    targetEndpointId     String           @default("") @map("target_endpoint_id")
    /// lower(trim(email)), set by the guard trigger.
    emailNormalised      String           @default("") @map("email_normalised")
    createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

    batch                InvitationBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
    sourceIdentity       Identity         @relation(fields: [sourceIdentityId], references: [id], onDelete: Restrict)
    route                Route            @relation(fields: [routeId], references: [id], onDelete: Restrict)
    targetEndpoint       Endpoint         @relation(fields: [targetEndpointId], references: [id], onDelete: Restrict)
    deselectionDifferences ExpectedDifference[]

    @@unique([batchId, sourceIdentityId])
    @@index([sourceIdentityId])
    @@map("invitation")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

// Operators manage Waves through RPC (API-012). Deleting a Wave unsets Migration.waveId (DOM-013).
model Wave {
    id          String      @id @default(uuid(7)) @deny('update', true)
    name        String      @unique
    targetDate  DateTime?   @map("target_date") @db.Timestamptz(3)
    description String?
    createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

    migrations  Migration[]

    @@map("wave")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
    @@allow('create,update,delete', auth().role in [operator, admin] && auth().disabled == false)
}

// LIF-030. Admin-managed through RPC (API-012).
model NamingRule {
    id        String   @id @default(uuid(7)) @deny('update', true)
    routeId   String   @map("route_id")
    scope     String // namespace | repository (the route default lives in config only)
    scopeRef  String   @map("scope_ref") // Namespace.id or Repository.id
    pipeline  Json // NamingPipeline type
    override  String? // literal target name (repository scope)
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    route     Route    @relation(fields: [routeId], references: [id], onDelete: Restrict)

    @@unique([routeId, scope, scopeRef])
    @@map("naming_rule")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
    @@allow('create,update,delete', auth().role == admin && auth().disabled == false)
}

// Admin-managed through RPC (API-012).
model WebhookAllowlistEntry {
    id        String   @id @default(uuid(7)) @deny('update', true)
    routeId   String   @map("route_id")
    pattern   String // URL glob, see FAC-WEB-002
    note      String?
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    route     Route    @relation(fields: [routeId], references: [id], onDelete: Restrict)

    @@map("webhook_allowlist_entry")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
    @@allow('create,update,delete', auth().role == admin && auth().disabled == false)
}

// Read through RPC (API-012). Writes go through the validated /api/v1/overlays endpoints only:
// `data` depends on `facetKey` and the RPC mount cannot validate it against the Facet schema
// (DOM-003, ADR-0362), so no role may create, update or delete an Overlay over RPC.
model Overlay {
    id        String   @id @default(uuid(7)) @deny('update', true)
    routeId   String   @map("route_id")
    facetKey  String   @map("facet_key")
    data      Json // partial canonical document for the facet
    enabled   Boolean  @default(true)
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    route     Route    @relation(fields: [routeId], references: [id], onDelete: Restrict)

    @@map("overlay")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

// Append-only: only its own timestamp.
model AuditEvent {
    id          String   @id @default(uuid(7))
    actorId     String?  @map("actor_id") // null = system
    action      String // e.g. "migration.mark_complete"
    subjectType String   @map("subject_type")
    subjectId   String   @map("subject_id")
    data        Json?
    at          DateTime @default(now()) @db.Timestamptz(3)

    actor       Actor?   @relation(fields: [actorId], references: [id], onDelete: Restrict)

    @@index([at(sort: Desc)])
    @@index([subjectType, subjectId])
    @@map("audit_event")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
    // Written by the RPC audit plugin (AUTH-022) inside the mutation's own transaction, where the
    // plugin chain cannot be switched, so the write runs as the Actor. An Actor may therefore
    // create an event about itself only, and the forActor facade exposes no AuditEvent write
    // (ADR-0201). Never updated or deleted.
    @@allow('create', auth() != null && auth().disabled == false && actorId == auth().id)
}

// Sliding-window ledger (JOB-041). Append-only: only its own timestamp.
model QuotaEvent {
    id        BigInt   @id @default(autoincrement())
    bucketKey String   @map("bucket_key")
    pool      String // background | interactive
    at        DateTime @db.Timestamptz(3)

    @@index([bucketKey, at])
    @@map("quota_event")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

// Cross-pod concurrency caps (JOB-045).
model QuotaLease {
    id        BigInt   @id @default(autoincrement())
    bucketKey String   @map("bucket_key")
    holder    String
    expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

    @@index([bucketKey, expiresAt])
    @@map("quota_lease")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}

model QuotaState {
    bucketKey      String    @id @map("bucket_key")
    limitPerWindow Int       @map("limit_per_window")
    windowSeconds  Int       @map("window_seconds")
    remaining      Int? // only when the provider reports it
    resetAt        DateTime? @map("reset_at") @db.Timestamptz(3)
    blockedUntil   DateTime? @map("blocked_until") @db.Timestamptz(3) // set on 429 / secondary limits
    createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

    @@map("quota_state")
    @@schema('app')
    @@allow('read', auth() != null && auth().disabled == false)
}
